{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "platformAutomerge": false,
  "separateMinorPatch": true,
  "packageRules": [
    {
      "description": "Automerge patch releases and digest updates after checks pass",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "docker minor",
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "docker patch and digest",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ]
    },
    {
      "description": "Disable major updates for PostgreSQL Docker images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": [
        "custom.minecraft-java"
      ],
      "matchPackageNames": [
        "minecraft-java"
      ],
      "groupName": "minecraft version",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Compare SearXNG release dates without treating commit hashes as image variants",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "searxng/searxng",
        "docker.io/searxng/searxng"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-[a-f0-9]+$"
    },
    {
      "description": "Keep the llama.cpp Vulkan variant and require review for new build numbers",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/ggml-org/llama.cpp"
      ],
      "versioning": "regex:^(?<compatibility>server-vulkan)-b(?<major>\\d+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(docker-)?compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "mc:\\n(?:[ \\t]+[^\\n]*\\n)*?[ \\t]+image:\\s*itzg/minecraft-server(?::[^@\\n]+)?(?:@sha256:[a-f0-9]+)?\\n(?:[ \\t]+[^\\n]*\\n)*?[ \\t]+VERSION:\\s*\"(?<currentValue>[^\"\\n]+)\""
      ],
      "depNameTemplate": "minecraft-java",
      "datasourceTemplate": "custom.minecraft-java",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "minecraft-java": {
      "defaultRegistryUrlTemplate": "https://launchermeta.mojang.com/mc/game/version_manifest.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $.latest.release}]}"
      ]
    }
  }
}
