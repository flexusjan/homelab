{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "groupName": "docker non-major",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["custom.minecraft-java"],
      "matchPackageNames": ["minecraft-java"],
      "groupName": "minecraft version",
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(docker-)?compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "mc:\\n(?:[ \\t]+[^\\n]*\\n)*?[ \\t]+image:\\s*itzg/minecraft-server(?::[^@\\n]+)?(?:@sha256:[a-f0-9]+)?\\n(?:[ \\t]+[^\\n]*\\n)*?[ \\t]+VERSION:\\s*\"(?<currentValue>[^\"\\n]+)\""
      ],
      "depNameTemplate": "minecraft-java",
      "datasourceTemplate": "custom.minecraft-java",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "minecraft-java": {
      "defaultRegistryUrlTemplate": "https://launchermeta.mojang.com/mc/game/version_manifest.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $.latest.release}]}"
      ]
    }
  }
}